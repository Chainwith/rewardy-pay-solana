{
  "name": "rewardy-pay-solana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Executable Solana payment and settlement proof for Rewardy Pay.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "proof:verify": "tsx scripts/verify-existing-transaction.ts",
    "demo:devnet": "tsx scripts/execute-devnet-payment.ts",
    "demo:address": "tsx scripts/execute-devnet-payment.ts --print-address",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.9",
    "@solana/web3.js": "1.95.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.2"
  }
}
